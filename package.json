{
  "name": "ureg",
  "private": true,
  "description": "UReg — a universal registry for everything your organization runs automatically.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/shared",
    "packages/cli",
    "db"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @ureg/web",
    "dev:worker": "npm run dev -w @ureg/worker",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run generate -w @ureg/db",
    "db:migrate": "npm run migrate -w @ureg/db",
    "ureg": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
